{
  "manifest_version": 3,
  "name": "Copilot Credits Monitor",
  "version": "1.0.0",
  "description": "Visualise la consommation de vos credits Copilot (endpoint /v1/cost) sous forme de graphiques.",
  "permissions": ["webRequest", "storage", "alarms"],
  "host_permissions": ["*://*.powerapps.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copilot Credits Monitor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
